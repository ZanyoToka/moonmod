# ============================================================
# AI NPC Python 中间件配置文件示例
# 复制此文件为 .env 并填入你的实际 API 配置
# ============================================================

# LLM 服务商配置 (兼容 OpenAI 协议)
# 常用示例 1: 智谱 GLM (https://open.bigmodel.cn/api/paas/v4, model: glm-4-flash)
# 常用示例 2: DeepSeek (https://api.deepseek.com/v1, model: deepseek-chat)
# 常用示例 3: 硅基流动 (https://api.siliconflow.cn/v1, model: deepseek-ai/DeepSeek-V3)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 服务监听配置
HOST=127.0.0.1
PORT=8000

# 记忆管理 (Mem0) 配置
# 是否启用 Mem0 向量记忆库 (如果为 False，将使用本地内存记忆回退机制)
MEM0_ENABLED=true
